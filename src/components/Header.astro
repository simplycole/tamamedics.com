---
const path = Astro.url.pathname;
const links = [['Clinic','/clinic/'],['Research','/research/'],['Projects','/projects/'],['Devices','/devices/'],['Patches','/patches/'],['Lab Notes','/lab-notes/'],['Downloads','/downloads/'],['Contribute','/contributing/']];
---
<header class="site-header"><a class="skip" href="#main-content">Skip to content</a><div class="container header-inner"><a class="brand" href="/" aria-label="TamaMedics home"><img src="/tamamedics-icon-square.png" width="38" height="38" alt="" /><span>TAMA<b>MEDICS</b></span></a><nav aria-label="Primary navigation"><details><summary>Menu <i aria-hidden="true"></i></summary><div class="nav-links">{links.map(([label, href]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}<a href="https://github.com/simplycole/tamamedics.com" target="_blank" rel="noopener noreferrer">GitHub</a></div></details></nav><span class="system"><i aria-hidden="true"></i> System: Online</span></div></header>
<style>
  .site-header{position:sticky;top:0;z-index:20;border-bottom:1px solid var(--tm-border);background:rgba(13,9,19,.88);backdrop-filter:blur(16px)}.header-inner{display:flex;align-items:center;gap:1.25rem;min-height:72px}.brand{display:flex;align-items:center;gap:.65rem;color:var(--tm-text);font:900 1rem var(--font-mono);letter-spacing:.08em;text-decoration:none}.brand img{border-radius:10px;box-shadow:0 0 20px rgba(240,106,168,.24)}.brand b{color:var(--tm-pink-bright)}nav{margin-left:auto}details summary{display:none}.nav-links{display:flex;align-items:center;gap:1rem}.nav-links a{color:var(--tm-text-muted);font:700 .7rem var(--font-mono);text-decoration:none;text-transform:uppercase}.nav-links a:hover,.nav-links a[aria-current="page"]{color:var(--tm-cyan)}.system{display:flex;align-items:center;gap:.4rem;padding:.35rem .6rem;border:1px solid rgba(200,240,131,.25);border-radius:999px;color:var(--tm-lcd);font:700 .62rem var(--font-mono);text-transform:uppercase;white-space:nowrap}.system i{width:7px;height:7px;border-radius:50%;background:var(--tm-success);box-shadow:0 0 8px var(--tm-success)}.skip{position:absolute;left:1rem;top:-5rem;z-index:30;padding:.65rem;background:var(--tm-cyan);color:#111}.skip:focus{top:.5rem}
  @media(max-width:1040px){details{position:relative}details summary{display:flex;align-items:center;gap:.5rem;cursor:pointer;color:var(--tm-text);font:700 .75rem var(--font-mono);text-transform:uppercase}details summary::marker{content:""}details summary i{width:18px;height:12px;border-block:2px solid var(--tm-cyan)}.nav-links{position:absolute;right:0;top:2.2rem;display:grid;min-width:220px;padding:1rem;border:1px solid var(--tm-border);border-radius:var(--radius-md);background:var(--tm-bg-elevated);box-shadow:var(--shadow-panel)}details:not([open]) .nav-links{display:none}}@media(max-width:600px){.system{display:none}.header-inner{min-height:62px}}
</style>
