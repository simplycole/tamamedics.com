---
import StatusBadge from './StatusBadge.astro';
interface Props {
  title: string; slug: string; summary: string; projectId: string; device: string; category: string;
  status: 'active'|'paused'|'complete';
  confidence: 'confirmed'|'observed'|'community'|'unverified'|'researching'|'planned';
}
const { title, slug, summary, projectId, device, category, status, confidence } = Astro.props;
const statusMap = { active: 'active', paused: 'researching', complete: 'archived' } as const;
---
<article class="case-file">
  <header class="case-header"><div><span class="technical-label">Case file</span><b>{projectId}</b></div><StatusBadge status={statusMap[status]} /></header>
  <div class="case-body">
    <div class="case-copy">
      <h3>{title}</h3>
      <dl class="identity"><div><dt>Patient</dt><dd>{device}</dd></div><div><dt>Category</dt><dd>{category}</dd></div></dl>
      <p>{summary}</p>
      <div class="objective"><span class="technical-label">Evidence state</span><StatusBadge status={confidence} /></div>
      <a class="button secondary" href={`/research/${slug}/`}>Open case file</a>
    </div>
    <div class="evidence">
      <div class="evidence-head"><span class="technical-label">Research protocol</span><small>Confidence labeled</small></div>
      <ul><li>Separate observations from inference</li><li>Preserve source and method context</li><li>Verify revisions and hashes</li><li>Distribute patches, not firmware</li></ul>
      <p class="caution">Provisional findings stay provisional until repeatable evidence supports them.</p>
    </div>
  </div>
</article>
<style>
  .case-file{border:1px solid var(--tm-border);border-radius:var(--radius-sm);background:#17101e;box-shadow:var(--shadow-panel);overflow:hidden}.case-header{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.8rem 1rem;border-bottom:1px solid var(--tm-border);background:linear-gradient(90deg,rgba(240,106,168,.16),transparent)}.case-header>div{display:flex;align-items:center;gap:.7rem}.case-header .technical-label{margin:0}.case-header b{font:800 .72rem var(--font-mono)}.case-body{display:grid;grid-template-columns:1.15fr .85fr}.case-copy,.evidence{padding:clamp(1.25rem,3vw,2rem)}.case-copy{border-right:1px solid var(--tm-border-soft)}h3{margin:0 0 1rem;font-size:clamp(1.35rem,3vw,2rem)}.identity{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:0 0 1rem}.identity div{padding:.65rem;border:1px solid var(--tm-border-soft)}dt{color:var(--tm-cyan);font:700 .58rem var(--font-mono);text-transform:uppercase}dd{margin:.25rem 0 0;font-size:.82rem}.objective{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin:1.25rem 0}.objective .technical-label{margin:0}.evidence{background:rgba(113,229,226,.025)}.evidence-head{display:flex;justify-content:space-between;gap:1rem}.evidence-head small{color:var(--tm-text-muted);font:.6rem var(--font-mono);text-transform:uppercase}.evidence ul{margin:1rem 0;padding-left:1.2rem;color:var(--tm-text-muted)}.evidence li+li{margin-top:.65rem}.caution{padding-top:1rem;border-top:1px solid var(--tm-border-soft);font-size:.8rem}@media(max-width:760px){.case-body{grid-template-columns:1fr}.case-copy{border-right:0;border-bottom:1px solid var(--tm-border-soft)}}@media(max-width:480px){.identity{grid-template-columns:1fr}.objective{align-items:start;flex-direction:column}}
</style>
