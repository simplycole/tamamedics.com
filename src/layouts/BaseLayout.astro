---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title?: string; description?: string; type?: 'website'|'article'; }
const defaultDescription = 'Open-source Tamagotchi repair, preservation, reverse engineering, firmware research, tools, and community documentation.';
const { title='TamaMedics', description=defaultDescription, type='website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/tamamedics-icon-square.png', Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" /><link rel="icon" href="/favicon.ico" sizes="any" /><link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" /><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" /><link rel="canonical" href={canonical} /><meta property="og:type" content={type} /><meta property="og:site_name" content="TamaMedics" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={socialImage} /><title>{title}</title></head><body><Header /><main id="main-content"><slot /></main><Footer /></body></html>
