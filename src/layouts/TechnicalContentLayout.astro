---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import StatusBadge from '../components/StatusBadge.astro';
interface TocItem { href:string; label:string; }
interface Props { title:string; description:string; projectId:string; device:string; category:string; confidence:'confirmed'|'observed'|'community'|'unverified'|'researching'|'planned'; toc:TocItem[]; }
const { title, description, projectId, device, category, confidence, toc } = Astro.props;
---
<BaseLayout title={`${title} — TamaMedics`} description={description} type="article">
  <div class="container technical-shell">
    <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Research Lab',href:'/research/'},{label:title}]} />
    <header class="case-title">
      <div class="case-id"><span>Case file</span><strong>{projectId}</strong></div>
      <div><p class="eyebrow">Research Project #001</p><h1>{title}</h1><p class="lead">{description}</p></div>
      <dl><div><dt>Patient</dt><dd>{device}</dd></div><div><dt>Procedure</dt><dd>English Firmware Research</dd></div><div><dt>Status</dt><dd><StatusBadge status="active" /></dd></div><div><dt>Category</dt><dd>{category}</dd></div><div><dt>Confidence</dt><dd><StatusBadge status={confidence} /></dd></div></dl>
    </header>
    <div class="documentation-grid">
      <aside class="toc" aria-labelledby="toc-title"><p id="toc-title">Case file index</p><ol>{toc.map((item,index)=><li><a href={item.href}><span>{String(index+1).padStart(2,'0')}</span>{item.label}</a></li>)}</ol></aside>
      <article class="technical-content"><slot /></article>
    </div>
  </div>
</BaseLayout>
<style>
  .technical-shell{padding-block:var(--space-6) var(--space-8)}.case-title{position:relative;margin-top:1.25rem;padding:clamp(1.5rem,4vw,3rem);border:1px solid var(--tm-border);border-radius:var(--radius-lg);background:linear-gradient(135deg,rgba(240,106,168,.13),transparent 45%),var(--tm-panel-soft);box-shadow:var(--shadow-panel);overflow:hidden}.case-title:after{content:"";position:absolute;right:-5rem;top:-5rem;width:15rem;height:15rem;border:1px solid rgba(113,229,226,.12);border-radius:50%;box-shadow:0 0 0 2rem rgba(113,229,226,.025),0 0 0 5rem rgba(113,229,226,.02)}.case-id{display:flex;gap:.75rem;align-items:center;margin-bottom:1.4rem;color:var(--tm-cyan);font:700 .68rem var(--font-mono);letter-spacing:.1em;text-transform:uppercase}.case-id strong{padding:.25rem .45rem;border:1px solid currentColor;color:var(--tm-text)}h1{position:relative;z-index:1;max-width:900px;font-size:clamp(2.35rem,6vw,5.2rem)}.lead{position:relative;z-index:1}.case-title dl{position:relative;z-index:1;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:1rem;margin:2rem 0 0;padding-top:1.25rem;border-top:1px solid var(--tm-border-soft)}dt{color:var(--tm-cyan);font:700 .6rem var(--font-mono);text-transform:uppercase}dd{margin:.3rem 0 0;color:var(--tm-text);font-size:.82rem}.documentation-grid{display:grid;grid-template-columns:220px minmax(0,760px);justify-content:center;gap:clamp(2rem,6vw,5rem);margin-top:var(--space-7)}.toc{position:sticky;top:96px;align-self:start;padding:1rem;border-left:1px solid var(--tm-border)}.toc>p{margin:0 0 .75rem;color:var(--tm-pink-bright);font:750 .65rem var(--font-mono);text-transform:uppercase}.toc ol{margin:0;padding:0;list-style:none}.toc li+li{margin-top:.45rem}.toc a{display:grid;grid-template-columns:1.8rem 1fr;color:var(--tm-text-muted);font-size:.75rem;line-height:1.35;text-decoration:none}.toc a:hover{color:var(--tm-cyan)}.toc span{color:#776c80;font:600 .6rem var(--font-mono)}.technical-content{min-width:0}.technical-content :global(section){scroll-margin-top:6rem;margin-bottom:3.5rem}.technical-content :global(h2){margin:0 0 1.15rem;padding-bottom:.65rem;border-bottom:1px solid var(--tm-border);font-size:clamp(1.65rem,4vw,2.35rem)}.technical-content :global(h3){margin-top:2rem;color:var(--tm-violet)}.technical-content :global(p),.technical-content :global(li){font-size:1rem}.technical-content :global(ul),.technical-content :global(ol){padding-left:1.3rem;color:var(--tm-text-muted)}.technical-content :global(li+li){margin-top:.5rem}.technical-content :global(code){padding:.12em .35em;border:1px solid var(--tm-border-soft);background:#09070d;color:var(--tm-lcd);font:.88em var(--font-mono)}.technical-content :global(.table-scroll){max-width:100%;overflow-x:auto}.technical-content :global(table){width:100%;border-collapse:collapse;font-size:.85rem}.technical-content :global(th),.technical-content :global(td){padding:.75rem;border:1px solid var(--tm-border-soft);text-align:left;vertical-align:top}.technical-content :global(th){background:rgba(113,229,226,.08);color:var(--tm-cyan);font:700 .65rem var(--font-mono);text-transform:uppercase}.technical-content :global(.actions){display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.5rem}.technical-content :global(.phase-grid){display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem}.technical-content :global(.phase-grid>div){padding:1rem;border:1px solid var(--tm-border-soft);background:var(--tm-panel-soft)}.technical-content :global(.phase-grid strong){display:block;margin-bottom:.35rem;color:var(--tm-cyan);font:.65rem var(--font-mono);text-transform:uppercase}@media(max-width:900px){.case-title dl{grid-template-columns:repeat(2,1fr)}.documentation-grid{grid-template-columns:1fr}.toc{position:static}.toc ol{columns:2}.technical-content :global(.phase-grid){grid-template-columns:1fr}}@media(max-width:560px){.case-title dl{grid-template-columns:1fr}.toc ol{columns:1}.technical-shell{width:min(100% - 1rem,1180px)}}
</style>
