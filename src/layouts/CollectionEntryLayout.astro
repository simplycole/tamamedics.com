---
import BaseLayout from './BaseLayout.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro'; import StatusBadge from '../components/StatusBadge.astro';
interface TocItem { href:string; label:string; }
interface Props { title:string; description:string; section:string; sectionHref:string; status?:'confirmed'|'observed'|'community'|'unverified'|'researching'|'planned'; metadata?:[string,string][]; toc?:TocItem[]; }
const { title, description, section, sectionHref, status, metadata=[], toc=[] } = Astro.props;
---
<BaseLayout title={`${title} — TamaMedics`} description={description} type="article"><div class="container page-shell entry-shell"><Breadcrumbs items={[{label:'Home',href:'/'},{label:section,href:sectionHref},{label:title}]} /><header><div><p class="eyebrow">{section}</p><h1>{title}</h1><p class="lead">{description}</p></div>{status && <StatusBadge {status} />}{metadata.length > 0 && <dl>{metadata.map(([term,value])=><div><dt>{term}</dt><dd>{value}</dd></div>)}</dl>}</header><div class:list={['entry-grid',toc.length===0&&'without-toc']}>{toc.length>0&&<aside class="toc" aria-labelledby="guide-index"><p id="guide-index">Guide index</p><ol>{toc.map((item,index)=><li><a href={item.href}><span>{String(index+1).padStart(2,'0')}</span>{item.label}</a></li>)}</ol></aside>}<article class="entry-content"><slot /></article></div></div></BaseLayout>
<style>.entry-shell{width:min(1180px,calc(100% - 2rem))}.entry-shell>header{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:start;gap:var(--space-5);margin-top:var(--space-5);padding:clamp(1.25rem,4vw,2.5rem);border:1px solid var(--tm-border);background:var(--tm-panel-soft)}h1{font-size:clamp(2.2rem,7vw,4.5rem)}header dl{grid-column:1/-1;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:1rem;margin:0;padding-top:1.25rem;border-top:1px solid var(--tm-border-soft)}dt{color:var(--tm-cyan);font:700 .62rem var(--font-mono);text-transform:uppercase}dd{margin:.25rem 0 0;color:var(--tm-text);font-size:.8rem;text-transform:capitalize}.entry-grid{display:grid;grid-template-columns:220px minmax(0,780px);justify-content:center;gap:clamp(2rem,6vw,5rem);margin-top:var(--space-7)}.entry-grid.without-toc{grid-template-columns:minmax(0,900px)}.toc{position:sticky;top:96px;align-self:start;padding:1rem;border-left:1px solid var(--tm-border)}.toc>p{margin:0 0 .75rem;color:var(--tm-pink-bright);font:750 .65rem var(--font-mono);text-transform:uppercase}.toc ol{margin:0;padding:0;list-style:none}.toc li+li{margin-top:.4rem}.toc a{display:grid;grid-template-columns:1.8rem 1fr;color:var(--tm-text-muted);font-size:.74rem;line-height:1.35;text-decoration:none}.toc span{color:#877b8c;font:600 .6rem var(--font-mono)}.entry-content{min-width:0}.entry-content :global(section){scroll-margin-top:6rem;margin-bottom:3.5rem}.entry-content :global(h2),.entry-content :global(h3){scroll-margin-top:6rem}.entry-content :global(h2){padding-bottom:.65rem;border-bottom:1px solid var(--tm-border)}.entry-content :global(pre){max-width:100%;padding:1rem;overflow:auto;background:#09070d}.entry-content :global(code){overflow-wrap:anywhere;font-family:var(--font-mono)}.entry-content :global(figure){margin:2rem 0}.entry-content :global(figcaption){color:var(--tm-text-muted);font-size:.8rem}.entry-content :global(.table-scroll){max-width:100%;overflow-x:auto}.entry-content :global(table){width:100%;border-collapse:collapse;font-size:.86rem}.entry-content :global(th),.entry-content :global(td){padding:.7rem;border:1px solid var(--tm-border-soft);text-align:left;vertical-align:top}.entry-content :global(th){color:var(--tm-cyan);font:700 .66rem var(--font-mono);text-transform:uppercase}.entry-content :global(.verification-grid){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.entry-content :global(.verification-grid p){margin:0;padding:.7rem;border:1px solid var(--tm-border-soft)}.entry-content :global(.verification-grid strong){color:var(--tm-text)}@media(max-width:900px){header dl{grid-template-columns:repeat(2,1fr)}.entry-grid{grid-template-columns:1fr}.toc{position:static}.toc ol{columns:2}}@media(max-width:600px){.entry-shell>header{grid-template-columns:1fr}header dl{grid-template-columns:1fr}.toc ol{columns:1}.entry-content :global(.verification-grid){grid-template-columns:1fr}}</style>
