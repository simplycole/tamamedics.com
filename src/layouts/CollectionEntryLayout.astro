---
import BaseLayout from './BaseLayout.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro'; import StatusBadge from '../components/StatusBadge.astro';
interface Props { title:string; description:string; section:string; sectionHref:string; status?:'confirmed'|'observed'|'community'|'unverified'|'researching'|'planned'; }
const { title, description, section, sectionHref, status } = Astro.props;
---
<BaseLayout title={`${title} — TamaMedics`} description={description} type="article"><div class="container page-shell entry-shell"><Breadcrumbs items={[{label:'Home',href:'/'},{label:section,href:sectionHref},{label:title}]} /><header><div><p class="eyebrow">{section}</p><h1>{title}</h1><p class="lead">{description}</p></div>{status && <StatusBadge {status} />}</header><article class="entry-content"><slot /></article></div></BaseLayout>
<style>.entry-shell{width:min(900px,calc(100% - 2rem))}.entry-shell>header{display:flex;align-items:start;justify-content:space-between;gap:var(--space-5);margin-top:var(--space-5);padding-bottom:var(--space-6);border-bottom:1px solid var(--tm-border)}h1{font-size:clamp(2.2rem,7vw,4.5rem)}.entry-content{margin-top:var(--space-7)}.entry-content :global(h2),.entry-content :global(h3){scroll-margin-top:6rem}.entry-content :global(pre){max-width:100%;padding:1rem;overflow:auto;background:#09070d}.entry-content :global(code){overflow-wrap:anywhere;font-family:var(--font-mono)}.entry-content :global(figure){margin:2rem 0}.entry-content :global(figcaption){color:var(--tm-text-muted);font-size:.8rem}@media(max-width:600px){.entry-shell>header{flex-direction:column}}</style>
