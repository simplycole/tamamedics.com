---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
const departments = [
  ['Clinic','Repair guides, diagnostics, teardown notes, and common hardware failures.','/clinic/','CLN','pink'],
  ['Research Lab','Firmware analysis, board mapping, and preservation research.','/research/','R&D','cyan'],
  ['Open Projects','Active investigations and community research efforts.','/projects/','PRJ','lcd'],
  ['Device Archive','Models, generations, revisions, and technical references.','/devices/','ARC','violet'],
  ['Patch Library','Deltas, tooling, checksums, and compatibility documentation.','/patches/','DIF','pink'],
  ['Lab Notes','Experiments, findings, and transparent project logs.','/lab-notes/','LOG','cyan'],
  ['Downloads','Open-source utilities, templates, scripts, and research aids.','/downloads/','GET','lcd'],
  ['Contributing','Help document and preserve virtual-pet hardware.','/contributing/','COM','violet'],
] as const;
const [featuredProject] = await getCollection('research');
---
<BaseLayout title="TamaMedics — Tamagotchi Repair, Research & Preservation">
  <div class="container page-shell home-shell">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">TamaMedics // Virtual Pet Preservation Lab</p>
        <h1 id="hero-title">TAMA<span>MEDICS</span></h1>
        <h2>Open-source care for aging virtual pets.</h2>
        <p class="lead">Repair guides, hardware research, firmware reverse engineering, preservation documentation, and community-built tools for Tamagotchi hardware.</p>
        <div class="button-row"><a class="button" href="/clinic/">Enter the Clinic</a><a class="button secondary" href="/research/">Research Lab</a><a class="text-link" href="/projects/">View open projects →</a></div>
      </div>
      <div class="diagnostic-station" aria-label="TamaMedics diagnostic unit">
        <div class="screw one" aria-hidden="true"></div><div class="screw two" aria-hidden="true"></div>
        <header><span>TM-DIAG/01</span><b>Diagnostic unit</b><span>Service mode</span></header>
        <div class="station-body">
          <div class="mascot-well"><span class="scan-label">Patient scan</span><img src="/favicon-512.png" width="220" height="220" alt="TamaMedics virtual pet medic mascot" /><i aria-hidden="true"></i></div>
          <dl><div><dt>Patient</dt><dd>Virtual pet</dd></div><div><dt>Intake</dt><dd>Ready</dd></div><div><dt>Archive link</dt><dd>Online</dd></div></dl>
        </div>
        <footer><span><i></i>Power</span><span><i></i>Link</span><span><i></i>Archive</span><b>Patient ready</b></footer>
      </div>
    </section>

    <section class="status-strip" aria-label="System status"><dl><div><dt>System</dt><dd>Online</dd></div><div><dt>Archive</dt><dd>Building</dd></div><div><dt>Research</dt><dd>Active</dd></div><div><dt>Patch policy</dt><dd>Deltas only</dd></div></dl></section>

    <section class="section-block" aria-labelledby="featured-project"><div class="section-heading"><div><p class="eyebrow">Current investigation // Case 001</p><h2 id="featured-project">On the research bench.</h2></div><p>Our first open case documents what is known, what is provisional, and what still needs careful verification.</p></div>{featuredProject && <ProjectCard {...featuredProject.data} />}</section>

    <section class="section-block directory" aria-labelledby="directories"><div class="directory-intro"><p class="eyebrow">Clinic directory</p><h2 id="directories">Where do you want to start?</h2><p>Follow a fault into the clinic, inspect an active case, or browse the growing technical archive.</p><span class="directory-id">DIRECTORY / REV. 01</span></div><div class="department-grid">{departments.map(([title,description,href,code,accent]) => <FeatureCard {title} {description} {href} {code} {accent} />)}</div></section>

    <section class="section-block philosophy" aria-labelledby="philosophy-title"><div class="why"><p class="eyebrow">Why this clinic exists</p><h2 id="philosophy-title">Keeping virtual pets alive.</h2><p>These devices are aging. Batteries leak, contacts oxidize, LCDs fail, shells break, and hard-won knowledge disappears.</p><p>TamaMedics documents what we learn while devices can still be examined, repaired, dumped, photographed, and understood.</p></div><ol aria-label="TamaMedics method"><li><span>01</span><b>Repair it.</b></li><li><span>02</span><b>Document it.</b></li><li><span>03</span><b>Preserve it.</b></li><li><span>04</span><b>Share it.</b></li></ol></section>

    <section class="section-block activity" aria-labelledby="activity-title"><div><p class="eyebrow">Bench log // Current work</p><h2 id="activity-title">Lab activity</h2><p>No lab notes published yet. Initial research documentation is being prepared around Research Project #001.</p><a href="/lab-notes/">Open the lab journal →</a></div><dl><div><dt>Current case</dt><dd>Plus Color firmware research</dd></div><div><dt>Site status</dt><dd>Documentation infrastructure online</dd></div><div><dt>Next</dt><dd>Initial research documentation</dd></div></dl></section>

    <section class="section-block open-callout" aria-labelledby="open-title"><div><p class="eyebrow">Community service record</p><h2 id="open-title">Open clinic. Open research.</h2><p>TamaMedics is built around open research and reproducible documentation: repair procedures, research notes, board documentation, tools, scripts, patches, deltas, and checksums—while respecting copyrighted firmware.</p></div><div><p class="sticker">Careful methods.<br />Shared findings.</p><div class="button-row"><a class="button" href="/contributing/">Contributing guide</a><a class="button secondary" href="https://github.com/simplycole/tamamedics.com" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></div></section>
  </div>
</BaseLayout>
<style>
  .home-shell{padding-top:0}.hero{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(340px,.8fr);align-items:center;gap:clamp(2rem,5vw,4rem);min-height:calc(100svh - 72px);padding-block:var(--space-7)}.hero-copy{min-width:0}.hero h1{white-space:nowrap;font-size:clamp(3.65rem,7.2vw,6.65rem);line-height:.86;letter-spacing:-.078em}.hero h1 span{color:var(--tm-pink-bright)}.hero h2{max-width:690px;margin:1.7rem 0 1rem;font-size:clamp(1.7rem,4vw,3.25rem)}.text-link{align-self:center;margin-left:.35rem;font:700 .7rem var(--font-mono);text-transform:uppercase}.diagnostic-station{position:relative;border:1px solid #bd69a0;border-radius:1.25rem;background:linear-gradient(145deg,#593251,#2d203d 48%,#322044);box-shadow:inset 0 1px #ffffff3b,inset 0 -10px 20px #100a1666,0 25px 55px #0008;padding:.65rem}.diagnostic-station:before{content:"";position:absolute;inset:5px;border:1px solid #ffffff18;border-radius:.95rem;pointer-events:none}.diagnostic-station header{position:relative;display:flex;justify-content:space-between;gap:.5rem;padding:.55rem .75rem;color:#eacfe1;font:600 .55rem var(--font-mono);letter-spacing:.08em;text-transform:uppercase}.diagnostic-station header b{color:#fff}.station-body{position:relative;display:grid;grid-template-columns:1fr .7fr;gap:.7rem}.mascot-well{position:relative;display:grid;place-items:center;min-height:310px;border:8px solid #24182e;border-radius:.8rem;background:radial-gradient(circle,#d0ef9f33,transparent 60%),repeating-linear-gradient(0deg,#b8d78308 0 1px,transparent 1px 4px),#263620;box-shadow:inset 0 0 35px #0008}.mascot-well img{width:min(82%,220px);border-radius:.45rem;filter:saturate(.88) contrast(1.04);mix-blend-mode:screen}.scan-label{position:absolute;left:.65rem;top:.5rem;z-index:1;color:var(--tm-lcd);font:600 .55rem var(--font-mono);text-transform:uppercase}.mascot-well>i{position:absolute;inset:12%;border:1px solid #c8f08333;border-radius:50%}.station-body dl{display:grid;align-content:stretch;gap:.5rem;margin:0}.station-body dl div{display:flex;flex-direction:column;justify-content:center;padding:.8rem;border:1px solid #c8f08342;border-radius:.35rem;background:linear-gradient(#cadf9b,#aabe80);box-shadow:inset 0 0 10px #50603566;color:#26321f}.station-body dt{font:700 .53rem var(--font-mono);letter-spacing:.08em;text-transform:uppercase}.station-body dd{margin:.2rem 0 0;font:800 .73rem var(--font-mono);text-transform:uppercase}.diagnostic-station footer{position:relative;display:flex;align-items:center;gap:1rem;padding:.7rem .6rem .25rem;color:#f3dae8;font:600 .54rem var(--font-mono);text-transform:uppercase}.diagnostic-station footer span{display:flex;align-items:center;gap:.3rem}.diagnostic-station footer i{width:6px;height:6px;border-radius:50%;background:var(--tm-lcd);box-shadow:0 0 7px var(--tm-lcd)}.diagnostic-station footer b{margin-left:auto;color:var(--tm-lcd);font-weight:600}.screw{position:absolute;z-index:2;width:8px;height:8px;border:1px solid #160d19;border-radius:50%;background:#b077a2;box-shadow:inset 1px 1px #e5afd1}.screw:after{content:"";position:absolute;left:1px;right:1px;top:3px;border-top:1px solid #251122;transform:rotate(-25deg)}.screw.one{left:10px;top:10px}.screw.two{right:10px;bottom:10px}.status-strip{border-block:1px solid rgba(200,240,131,.25);background:#111811}.status-strip dl{display:grid;grid-template-columns:repeat(4,1fr);margin:0}.status-strip dl div{display:flex;justify-content:space-between;gap:.5rem;padding:.75rem 1rem;border-right:1px solid rgba(200,240,131,.16);font:.63rem var(--font-mono);text-transform:uppercase}.status-strip dl div:last-child{border:0}.status-strip dt{color:#809171}.status-strip dd{margin:0;color:var(--tm-lcd)}.directory{display:grid;grid-template-columns:.7fr 1.3fr;gap:clamp(1.5rem,5vw,4rem);align-items:start}.directory-intro{position:sticky;top:110px}.directory-intro h2{margin:.4rem 0}.directory-id{display:block;margin-top:2rem;color:#796e7f;font:600 .61rem var(--font-mono)}.department-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.philosophy{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,7vw,6rem);padding:clamp(1.5rem,5vw,4rem);border-block:1px solid var(--tm-border);background:linear-gradient(115deg,rgba(240,106,168,.09),transparent 45%)}.why h2{margin:.5rem 0 1.5rem}.philosophy ol{display:grid;align-content:center;margin:0;padding:0;list-style:none}.philosophy li{display:grid;grid-template-columns:3rem 1fr;align-items:center;padding:1rem 0;border-bottom:1px solid var(--tm-border-soft)}.philosophy li span{color:var(--tm-cyan);font:.65rem var(--font-mono)}.philosophy li b{font-size:clamp(1.2rem,3vw,2rem)}.activity{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-7);padding:clamp(1.5rem,4vw,2.5rem);border:1px solid var(--tm-border-soft);border-left:4px solid var(--tm-cyan);background:#121019}.activity h2{margin:.3rem 0}.activity dl{margin:0}.activity dl div{display:grid;grid-template-columns:.55fr 1fr;gap:1rem;padding:.75rem;border-bottom:1px solid var(--tm-border-soft)}.activity dt{color:var(--tm-cyan);font:650 .62rem var(--font-mono);text-transform:uppercase}.activity dd{margin:0;color:var(--tm-text-muted);font-size:.84rem}.open-callout{display:grid;grid-template-columns:1.3fr .7fr;gap:var(--space-7);align-items:center;padding:clamp(1.5rem,5vw,3.5rem);border:1px solid var(--tm-border);border-radius:var(--radius-lg);background:linear-gradient(135deg,#2a1830,#161a24);box-shadow:var(--shadow-panel)}.open-callout h2{margin:.4rem 0}.sticker{width:fit-content;margin:0 0 1rem auto;padding:.7rem 1rem;border:1px solid var(--tm-lcd);transform:rotate(2deg);color:var(--tm-lcd);font:700 .66rem var(--font-mono);text-transform:uppercase}.open-callout>div:last-child{justify-self:end}
  @media(max-width:900px){.hero{grid-template-columns:1fr;min-height:auto;padding-block:var(--space-8)}.diagnostic-station{width:min(100%,620px)}.directory{grid-template-columns:1fr}.directory-intro{position:static}.philosophy,.activity,.open-callout{grid-template-columns:1fr}.open-callout>div:last-child{justify-self:start}.sticker{margin-left:0}}
  @media(max-width:620px){.hero h1{font-size:clamp(2.65rem,14.7vw,5rem);letter-spacing:-.085em}.station-body{grid-template-columns:1fr}.mascot-well{min-height:250px}.station-body dl{grid-template-columns:repeat(3,1fr)}.station-body dl div{padding:.55rem}.status-strip dl{grid-template-columns:1fr 1fr}.status-strip dl div:nth-child(2){border-right:0}.status-strip dl div:nth-child(-n+2){border-bottom:1px solid rgba(200,240,131,.16)}.department-grid{grid-template-columns:1fr}.activity dl div{grid-template-columns:1fr}.diagnostic-station footer{flex-wrap:wrap}.diagnostic-station footer b{width:100%;margin:0}}
</style>
