---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Archive Record Not Found — TamaMedics" description="The requested TamaMedics archive record could not be found." noindex><div class="container page-shell error-shell"><section class="error-panel" aria-labelledby="error-title"><p class="eyebrow">Archive query // Error 404</p><h1 id="error-title">Patient record not found.</h1><p class="lead">The requested page may have moved, or the archive record may not exist yet. The rest of the clinic is still online.</p><nav class="button-row" aria-label="Error page links"><a class="button" href="/">Return home</a><a class="button secondary" href="/research/">Research lab</a><a class="button secondary" href="/clinic/">Clinic</a></nav></section></div></BaseLayout>
<style>.error-shell{display:grid;place-items:center;min-height:68vh}.error-panel{width:min(100%,850px);padding:clamp(1.5rem,6vw,4rem);border:1px solid var(--tm-border);border-top-color:var(--tm-warning);border-radius:var(--radius-lg);background:linear-gradient(135deg,rgba(240,106,168,.12),transparent 45%),var(--tm-panel-soft);box-shadow:var(--shadow-panel)}h1{font-size:clamp(2.5rem,8vw,5.5rem)}.lead{max-width:42rem}</style>
