---
import ContentLayout from '../../layouts/ContentLayout.astro'; import FeatureCard from '../../components/FeatureCard.astro';
const items=[['Utilities','Open-source diagnostic and research tools.'],['Templates','Structured worksheets for repair and research records.'],['Scripts','Reproducible helpers for preservation workflows.'],['Documentation Assets','Community-ready diagrams and reference materials.']];
---
<ContentLayout title="Downloads" description="Open-source utilities, templates, scripts, and technical resources." eyebrow="Tool cabinet // inventory building"><section class="section-block"><h2>Planned resource shelves</h2><div class="card-grid">{items.map(([title,description],i)=><FeatureCard {title} {description} href="/downloads/" code={`T0${i+1}`} action="Inventory pending" />)}</div></section><section class="section-block empty-state"><p class="technical-label">Cabinet status // Empty</p><h2>No downloads published yet.</h2><p>Future releases will include clear licenses, source, checksums, and usage notes.</p></section></ContentLayout>
