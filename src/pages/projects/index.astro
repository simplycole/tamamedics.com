---
import ContentLayout from '../../layouts/ContentLayout.astro'; import ProjectCard from '../../components/ProjectCard.astro'; import { getCollection } from 'astro:content';
const projects = await getCollection('research');
---
<ContentLayout title="Open Projects" description="Active community investigations with transparent methods, evidence, and status." eyebrow="Project registry // Case 001 open" status="active"><section class="section-block project-list">{projects.map(project => <ProjectCard {...project.data} />)}</section><section class="section-block panel panel-pad"><h2>Join an investigation</h2><p>Project records collect scoped questions, reproducible methods, confidence labels, and contribution needs. Additional projects will appear when real research is ready to share.</p><a href="/contributing/">Contribution guidelines →</a></section></ContentLayout><style>.project-list{display:grid;gap:var(--space-5)}</style>
