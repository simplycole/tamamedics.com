---
import ContentLayout from '../../layouts/ContentLayout.astro'; import ProjectCard from '../../components/ProjectCard.astro'; import { getCollection } from 'astro:content';
const projects = (await getCollection('research')).sort((a, b) => a.data.projectId.localeCompare(b.data.projectId));
---
<ContentLayout title="Open Projects" description="Active community investigations with transparent methods, evidence, and status." eyebrow="Project registry // open investigations" status="active"><section class="section-block project-list"><h2 class="visually-hidden">Research projects</h2>{projects.map(project => <ProjectCard {...project.data} />)}</section><section class="section-block panel panel-pad"><h2>Join an investigation</h2><p>Project records collect scoped questions, reproducible methods, confidence labels, and contribution needs. Help preserve firmware knowledge and the online services that connected hardware depends on.</p><a href="/contributing/">Contribution guidelines →</a></section></ContentLayout><style>.project-list{display:grid;gap:var(--space-5)}</style>
