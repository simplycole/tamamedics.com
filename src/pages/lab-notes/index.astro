---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getCollection } from 'astro:content';
const noteFiles = import.meta.glob('../../content/lab-notes/*.{md,mdx}');
const notes = Object.keys(noteFiles).length > 0 ? await getCollection('lab-notes') : [];
---
<ContentLayout title="Lab Notes" description="Research updates, discoveries, experiments, and transparent project logs." eyebrow="Research journal // initializing">{notes.length === 0 ? <section class="section-block empty-state"><p class="technical-label">Journal status // Empty</p><h2>No lab notes filed yet.</h2><p>Research notes will appear here as experiments and investigations are documented. We would rather publish a careful record than invent activity to fill the shelf.</p><a href="/research/plus-color-english-firmware/">View the current case →</a></section> : <section class="section-block"><h2>Filed notes</h2><ul>{notes.map(note=><li>{note.data.title}</li>)}</ul></section>}</ContentLayout>
