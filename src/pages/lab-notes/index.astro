---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getCollection } from 'astro:content';
const notes = await getCollection('lab-notes');
---
<ContentLayout title="Lab Notes" description="Research updates, discoveries, experiments, and transparent project logs." eyebrow="Research journal // initializing">{notes.length === 0 ? <section class="section-block empty-state"><p class="technical-label">Journal status // Empty</p><h2>No lab notes filed yet.</h2><p>Research notes will appear here as experiments and investigations are documented. We would rather publish a careful record than invent activity to fill the shelf.</p><a href="/research/plus-color-english-firmware/">View the current case →</a></section> : <section class="section-block"><h2>Filed notes</h2><ul class="record-list">{notes.map(note=><li><a href={`/lab-notes/${note.id.replace(/\.(md|mdx)$/,'')}/`}><strong>{note.data.title}</strong><span>{note.data.summary}</span></a></li>)}</ul></section>}</ContentLayout><style>.record-list{display:grid;gap:var(--space-3);padding:0;list-style:none}.record-list a{display:grid;padding:var(--space-4);border:1px solid var(--tm-border-soft);text-decoration:none}.record-list span{color:var(--tm-text-muted)}</style>
