import ContentLayout from '../../layouts/ContentLayout.astro';
---
<ContentLayout title="Contributing" description="Help build careful, verifiable, and welcoming virtual pet preservation documentation." eyebrow="Community intake // open" status="active"><section class="section-block panel panel-pad"><h2>Useful contributions</h2><div class="columns"><ul class="plain-list"><li>PCB photographs, chip markings, and board revision identifiers</li><li>Firmware hashes and dump metadata—never firmware files</li><li>Pin mappings, voltage measurements, and repair observations</li><li>Emulator findings and translation notes</li><li>Patch test results, source corrections, and documentation improvements</li></ul><div><h3>Share safely</h3><p><strong>Do not upload copyrighted firmware.</strong> Remove names, addresses, account details, privacy-sensitive serial identifiers, and unrelated identifying data. State your method, tools, device model, revision, confidence, and reproduction result clearly.</p><a class="button" href="https://github.com/simplycole/tamamedics.com" target="_blank" rel="noopener noreferrer">Contribute on GitHub <span class="visually-hidden">(opens in a new tab)</span></a></div></div></section></ContentLayout>
<style>.columns{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-7)}@media(max-width:700px){.columns{grid-template-columns:1fr}}</style>
