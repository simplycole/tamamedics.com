---
import { getCollection, render } from 'astro:content';
import TechnicalContentLayout from '../../layouts/TechnicalContentLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('research');
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const toc = project.data.toc;
---
<TechnicalContentLayout title={project.data.title} description={project.data.summary} projectId={project.data.projectId} device={project.data.device} category={project.data.category} confidence={project.data.confidence} status={project.data.status} {toc}>
  <Content />
</TechnicalContentLayout>
