---
import { getCollection, render } from 'astro:content';
import TechnicalContentLayout from '../../layouts/TechnicalContentLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('research');
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const toc = [
  ['#case-summary','Project Summary'],['#case-status','Current Status'],['#case-goals','Goals'],['#case-known','What We Know'],['#case-unknown','What We Do Not Know'],['#case-architecture','Architecture Notes'],['#case-workflow','Preservation Workflow'],['#case-patch-strategy','Patch Strategy'],['#case-safety','Safety Principles'],['#case-evidence-labels','Evidence Labels'],['#case-research-log','Research Log'],['#case-questions','Open Questions'],['#case-contribute','How to Contribute'],['#case-references','References'],['#case-legal','Legal Policy'],
].map(([href,label])=>({href,label}));
---
<TechnicalContentLayout title={project.data.title} description={project.data.summary} projectId={project.data.projectId} device={project.data.device} category={project.data.category} confidence={project.data.confidence} {toc}>
  <Content />
</TechnicalContentLayout>
