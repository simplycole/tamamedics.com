---
import ContentLayout from '../../layouts/ContentLayout.astro'; import FeatureCard from '../../components/FeatureCard.astro'; import ProjectCard from '../../components/ProjectCard.astro'; import { getCollection } from 'astro:content';
const items=[['Firmware Analysis','Documenting behavior without redistributing copyrighted firmware.'],['PCB Mapping','Board photography, component identification, and traced connections.'],['CPU / Memory Research','Architecture and memory-map investigations.'],['Debug Interfaces','Documented test points and non-destructive investigation.'],['Emulation','Validation research and preservation tooling.'],['Preservation Methodology','Repeatable, evidence-labeled research practices.']];
const projects = await getCollection('research');
---
<ContentLayout title="Research Lab" description="Reverse engineering, firmware analysis, board mapping, and preservation research." eyebrow="Lab access // open research" status="active"><section class="section-block"><div class="section-heading"><div><p class="eyebrow">Active investigations</p><h2>Open case files</h2></div><p>Every technical claim is scoped and confidence-labeled.</p></div>{projects.map(project => <ProjectCard {...project.data} />)}</section><section class="section-block"><h2>Research disciplines</h2><div class="card-grid">{items.map(([title,description],i)=><FeatureCard {title} {description} code={`R0${i+1}`} action="Research area" />)}</div><p>Findings are labeled Confirmed, Observed, Community Reported, Unverified, Researching, or Planned as evidence permits.</p></section></ContentLayout>
