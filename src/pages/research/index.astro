---
import ContentLayout from '../../layouts/ContentLayout.astro'; import FeatureCard from '../../components/FeatureCard.astro'; import ProjectCard from '../../components/ProjectCard.astro';
const items=[['Firmware Analysis','Documenting behavior without redistributing copyrighted firmware.'],['PCB Mapping','Board photography, component identification, and traced connections.'],['CPU / Memory Research','Architecture and memory-map investigations.'],['Debug Interfaces','Documented test points and non-destructive investigation.'],['Emulation','Validation research and preservation tooling.'],['Preservation Methodology','Repeatable, evidence-labeled research practices.']];
---
<ContentLayout title="Research Lab" description="Reverse engineering, firmware analysis, board mapping, and preservation research." eyebrow="Lab access // open research" status="active"><section class="section-block"><div class="section-heading"><div><p class="eyebrow">Active investigation</p><h2>Research Project #001</h2></div><p>Every technical claim is scoped and confidence-labeled.</p></div><ProjectCard /></section><section class="section-block"><h2>Research disciplines</h2><div class="card-grid">{items.map(([title,description],i)=><FeatureCard {title} {description} href="/research/" code={`R0${i+1}`} action="Discipline overview" />)}</div><p>Findings will be labeled Confirmed, Observed, Community Reported, or Unverified as evidence permits.</p></section></ContentLayout>
