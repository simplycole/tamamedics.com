---
import { getCollection, render } from 'astro:content'; import CollectionEntryLayout from '../../layouts/CollectionEntryLayout.astro';
export async function getStaticPaths(){return (await getCollection('devices')).map(entry=>({params:{slug:entry.id.replace(/\.(md|mdx)$/,'')},props:{entry}}));} const { entry }=Astro.props; const { Content }=await render(entry);
---
<CollectionEntryLayout title={entry.data.name} description={entry.data.summary} section="Device Archive" sectionHref="/devices/" status={entry.data.status}><Content /></CollectionEntryLayout>
