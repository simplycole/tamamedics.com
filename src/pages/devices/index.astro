---
import ContentLayout from '../../layouts/ContentLayout.astro'; import FeatureCard from '../../components/FeatureCard.astro'; import { getCollection } from 'astro:content';
const eras=[['Original-era','Early virtual pet device families and known variants.'],['Connection-era','Connected-device generations and regional releases.'],['Color-era','Color-screen hardware generations and revisions.'],['Modern-era','Current device families and preservation references.']];
const devices = await getCollection('devices');
---
<ContentLayout title="Device Archive" description="A growing index of device generations, models, board revisions, and known hardware information." eyebrow="Archive index // cataloging"><section class="section-block"><div class="section-heading"><div><p class="eyebrow">Catalog structure</p><h2>Archive groupings</h2></div><p>Future records will cover hardware identification, revisions, board observations, repair context, and preservation notes.</p></div><div class="card-grid">{eras.map(([title,description],i)=><FeatureCard {title} {description} code={`D0${i+1}`} action="Cataloging in progress" />)}</div></section>{devices.length ? <section class="section-block"><h2>Published device records</h2><ul class="record-list">{devices.map(device=><li><a href={`/devices/${device.id.replace(/\.(md|mdx)$/,'')}/`}>{device.data.name}</a></li>)}</ul></section> : <section class="section-block empty-state"><p class="technical-label">Archive status // Cataloging</p><h2>Device records are being cataloged.</h2><p>No device records are published yet. Entries will appear only when their identifying details and sources are ready.</p></section>}</ContentLayout><style>.record-list{display:grid;gap:var(--space-3);padding:0;list-style:none}.record-list a{display:block;padding:var(--space-4);border:1px solid var(--tm-border-soft)}</style>
